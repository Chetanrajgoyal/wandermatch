# Kibi OAuth Configuration (example values only)
# Copy this file to .env and fill in real values from Google Cloud Console and Apple Developer.
# Never commit real secrets to version control.

# Google Identity Services
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sign in with Apple
# Get these from https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=com.yourcompany.kibi.web
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END EC PRIVATE KEY-----
APPLE_REDIRECT_URI=https://your-ngrok-or-https-domain/callback/apple

# Local development
LOCAL_HOST=http://localhost:8081
